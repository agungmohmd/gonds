# Dependencies
node_modules/

# Build output
dist/
out/
*.dmg
*.zip
*.blockmap

# Generated by scripts/makeicon.sh.
# assets/icon.icns is deliberately NOT ignored: electron-builder needs it on a
# fresh clone, so the built icon is committed even though it derives from
# assets/logo.png.
scripts/icon/icon-1024.png
scripts/icon/*.iconset/

# Demo recordings — frame dumps are large and regenerable
demo/

# Credentials and local overrides. Signing and notarisation are configured
# through the environment; nothing secret belongs in the repo.
.env
.env.*
*.p12
*.mobileprovision

# Logs
*.log
npm-debug.log*
yarn-error.log*
logs/

# Test and tooling artefacts
coverage/
.nyc_output/
.eslintcache

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

